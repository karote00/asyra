{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "rootDir": "src",
    "rootDirs": ["src", "dist"],
    "outDir": "dist",
    "declaration": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
