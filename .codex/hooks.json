{
  "description": "Project coordination checks for scoped writes and bounded handoffs. Review and trust this definition before activation.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --path-format=absolute --git-common-dir)/../scripts/agent-hook-adapter.mjs\"",
            "timeout": 5,
            "additionalContextLimit": 500
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --path-format=absolute --git-common-dir)/../scripts/agent-hook-adapter.mjs\"",
            "timeout": 5,
            "additionalContextLimit": 500
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --path-format=absolute --git-common-dir)/../scripts/agent-hook-adapter.mjs\"",
            "timeout": 5,
            "additionalContextLimit": 500
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --path-format=absolute --git-common-dir)/../scripts/agent-hook-adapter.mjs\"",
            "timeout": 5,
            "additionalContextLimit": 500
          }
        ]
      }
    ]
  }
}
