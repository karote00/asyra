  "calls": [
    {
      "index": 5,
      "tool": "define_design_criteria",
      "input": {
        "method": "以公分為世界座標，1 cm=1 px，統一正射俯視相機 azimuth 35°, elevation 28°, scale 1。508m 總高依官方文字資料；其他尺寸為附件比例推估，不宣稱測量精度。使用 projected-face 與 surface-grid，窗格重複幾何與跨立面連續玻璃色域分離；左上日光、深色窗隙與金屬高光。低裙樓向塔身一側延伸，不加入街景。",
        "references": [
          "使用者航拍附件：僅量體、基座關係及輪廓；不畫施工設備",
          "使用者裝飾特寫：僅如意形狀與金屬材質",
          "https://land.dof.gov.taipei/cp.aspx"
        ],
        "criteria": {
          "overall": {
            "requirement": "完整台北101，固定俯視三分之四視角，不加文字或景物",
            "description": "全棟從基座到尖端完整，透明周邊，統一投影及八節外擴輪廓",
            "verification": "visual",
            "requiredUnits": []
          },
          "base": {
            "requirement": "保留可見基座關係與表面",
            "description": "偏置裙樓、塔基交接、屋頂與立面細節",
            "verification": "visual",
            "requiredUnits": []
          },
          "facade": {
            "requirement": "精細寫實立面、窗框、材質與陰影",
            "description": "密集可編輯窗框，連續玻璃明暗、外擴竹節、簷口與結構不淪為示意圖",
            "verification": "visual",
            "requiredUnits": []
          },
          "ornament": {
            "requirement": "依裝飾特寫保留可見裝飾",
            "description": "如意雙捲曲、長柄與圓盤，金屬厚度及反光",
            "verification": "visual",
            "requiredUnits": []
          },
          "crown": {
            "requirement": "完整塔冠與尖端",
            "description": "可見上表面、退縮塔冠、層框與完整尖塔",
            "verification": "visual",
            "requiredUnits": []
          }
        },
        "detailRequired": true
      },
      "output": null
    },
