{
  "version": 2,
  "negativeCaseIds": ["cancel.outcome", "cancel.delivery"],
  "targetId": "transaction-atomicity",
  "architecturePath": "tools/flow-inspector/inspectors/transaction-flow-inspector.data.cjs",
  "specPath": "docs/ai/framework/packages/factory.md",
  "testFile": "packages/factory/src/__tests__/flow-proof.test.ts",
  "configFile": "packages/factory/src/__tests__/flow-proof.config.ts",
  "externalInputs": [
    "artifact:transaction-boundary",
    "artifact:transaction-outcome-request",
    "artifact:commit-validation"
  ],
  "flows": [
    {
      "id": "deferred-publication",
      "title": "Publish a committed change",
      "goal": "Consumers receive the captured change once, after a successful transaction.",
      "stepIds": [
        "record-reversible-journal",
        "finalize-transaction-state",
        "settle-local-shared-projection"
      ],
      "cases": [
        {
          "id": "deferred.snapshot",
          "stepId": "record-reversible-journal",
          "testName": "Factory flow proof deferred snapshot"
        },
        {
          "id": "deferred.outcome",
          "stepId": "finalize-transaction-state",
          "testName": "Factory flow proof deferred outcome"
        },
        {
          "id": "deferred.delivery",
          "stepId": "settle-local-shared-projection",
          "testName": "Factory flow proof deferred delivery"
        }
      ],
      "handoffs": [
        {
          "routeId": "boundary-to-journal",
          "decision": "required",
          "caseIds": ["deferred.snapshot"]
        },
        {
          "routeId": "journal-to-finalize",
          "decision": "required",
          "caseIds": ["deferred.outcome"]
        },
        {
          "routeId": "decision-to-finalize",
          "decision": "required",
          "caseIds": ["deferred.outcome"]
        },
        {
          "routeId": "validation-to-finalize",
          "decision": "required",
          "caseIds": ["deferred.outcome"]
        },
        {
          "routeId": "journal-to-shared",
          "decision": "required",
          "caseIds": ["deferred.delivery"]
        },
        {
          "routeId": "finalize-to-shared",
          "decision": "required",
          "caseIds": ["deferred.delivery"]
        }
      ]
    },
    {
      "id": "immediate-cancellation",
      "title": "Cancel an already visible change",
      "goal": "Cancellation restores the original value and compensates the published change without adding History.",
      "stepIds": [
        "record-reversible-journal",
        "finalize-transaction-state",
        "settle-local-shared-projection"
      ],
      "cases": [
        {
          "id": "cancel.snapshot",
          "stepId": "record-reversible-journal",
          "testName": "Factory flow proof cancel snapshot"
        },
        {
          "id": "cancel.outcome",
          "stepId": "finalize-transaction-state",
          "testName": "Factory flow proof cancel outcome"
        },
        {
          "id": "cancel.delivery",
          "stepId": "settle-local-shared-projection",
          "testName": "Factory flow proof cancel delivery"
        }
      ],
      "handoffs": [
        {
          "routeId": "boundary-to-journal",
          "decision": "required",
          "caseIds": ["cancel.snapshot"]
        },
        {
          "routeId": "journal-to-finalize",
          "decision": "required",
          "caseIds": ["cancel.outcome"]
        },
        {
          "routeId": "decision-to-finalize",
          "decision": "required",
          "caseIds": ["cancel.outcome"]
        },
        {
          "routeId": "validation-to-finalize",
          "decision": "bypassed",
          "caseIds": ["cancel.outcome"],
          "reason": "Direct rollback does not request commit validation; the outcome case proves inverse replay and zero History."
        },
        {
          "routeId": "journal-to-shared",
          "decision": "required",
          "caseIds": ["cancel.delivery"]
        },
        {
          "routeId": "finalize-to-shared",
          "decision": "required",
          "caseIds": ["cancel.delivery"]
        }
      ]
    }
  ],
  "defaultNegativeScenario": "inverse-regression",
  "scenarios": [
    {
      "id": "baseline",
      "title": "Current source",
      "expectedFailedCaseIds": []
    },
    {
      "id": "inverse-regression",
      "title": "Inverse regression demo",
      "expectedFailedCaseIds": ["cancel.outcome", "cancel.delivery"],
      "mutation": {
        "file": "packages/factory/src/data-transact.ts",
        "from": "inversePayload.after = (payload as { before?: unknown }).before",
        "to": "inversePayload.after = (payload as { after?: unknown }).after"
      }
    },
    {
      "id": "omitted-replay",
      "title": "Omitted replay demo",
      "expectedFailedCaseIds": ["cancel.outcome"],
      "mutation": {
        "file": "packages/factory/src/data-transact.ts",
        "from": "...this.rollbackJournal(),",
        "to": "...[],"
      }
    },
    {
      "id": "premature-publication",
      "title": "Premature publication demo",
      "expectedFailedCaseIds": ["deferred.delivery"],
      "mutation": {
        "file": "packages/factory/src/data-transact.ts",
        "from": "sharedDelivery: event.options?.sharedDelivery ?? 'transaction-end',",
        "to": "sharedDelivery: 'immediate',"
      }
    },
    {
      "id": "forbidden-commit",
      "title": "Forbidden commit demo",
      "expectedFailedCaseIds": ["cancel.outcome", "cancel.delivery"],
      "mutation": {
        "file": "packages/factory/src/data-transact.ts",
        "from": "if (options.outcome === 'rollback') {",
        "to": "if (options.outcome === 'rollback' && false) {"
      }
    },
    {
      "id": "omitted-compensation",
      "title": "Omitted compensation demo",
      "expectedFailedCaseIds": ["cancel.delivery"],
      "mutation": {
        "file": "packages/factory/src/data-transact.ts",
        "from": "...this.rollbackJournal(),\n      ...this.compensateImmediateSharedChanges()",
        "to": "...this.rollbackJournal()"
      }
    }
  ]
}
