{
  "version": 2,
  "manifestPath": "packages/ai-agent-runtime/flow-contracts.json",
  "targetId": "reusable-tool-composition",
  "architecturePath": "tools/flow-inspector/inspectors/reusable-tool-composition-flow-inspector.data.cjs",
  "specPath": "packages/ai-agent-runtime/TOOL_SPECIFICATION.md",
  "testFile": "packages/ai-agent-runtime/src/__tests__/recipe-flow.test.ts",
  "configFile": "packages/ai-agent-runtime/src/__tests__/recipe-flow.config.ts",
  "negativeCaseIds": [
    "admit.handoff",
    "register.handoff",
    "invoke.handoff",
    "persist.handoff",
    "invoke.iteration",
    "persist.iteration",
    "persist.nested",
    "persist.authority"
  ],
  "externalInputs": [],
  "flows": [
    {
      "id": "reusable-tool-lifecycle",
      "title": "Reusable tool lifecycle",
      "goal": "Verify typed admission, same-registry request visibility, secured invocation and durable reuse.",
      "stepIds": [
        "admit",
        "register",
        "invoke",
        "persist"
      ],
      "cases": [
        {
          "id": "admit.handoff",
          "stepId": "admit",
          "testName": "recipe proof rejects ineligible dependencies before registration",
          "implementationPaths": [
            "packages/ai-agent-runtime/src/recipe-admission.ts",
            "packages/ai-agent-runtime/src/recipe-schema.ts",
            "packages/ai-agent-runtime/src/tool-contract.ts"
          ]
        },
        {
          "id": "register.handoff",
          "stepId": "register",
          "testName": "recipe proof registers retry-safe scoped candidates in the canonical registry",
          "implementationPaths": [
            "packages/ai-agent-runtime/src/tool-library.ts",
            "packages/ai-agent-runtime/src/action-registry.ts"
          ]
        },
        {
          "id": "invoke.handoff",
          "stepId": "invoke",
          "testName": "recipe proof executes nested tools without scheduler deadlock or lost references",
          "implementationPaths": [
            "packages/ai-agent-runtime/src/recipe-execution.ts",
            "packages/ai-agent-runtime/src/invocation.ts",
            "packages/ai-agent-runtime/src/tool-contract.ts"
          ]
        },
        {
          "id": "persist.handoff",
          "stepId": "persist",
          "testName": "recipe proof saves without replay and validates durable reuse",
          "implementationPaths": [
            "packages/ai-agent-runtime/src/tool-store.ts",
            "packages/ai-agent-runtime/src/tool-library.ts",
            "packages/ai-agent-runtime/src/action-registry.ts"
          ]
        },
        {
          "id": "admit.iteration",
          "stepId": "admit",
          "testName": "recipe proof admits bounded state repair only from domain verification contracts",
          "implementationPaths": [
            "packages/ai-agent-runtime/src/recipe-admission.ts"
          ]
        },
        {
          "id": "invoke.iteration",
          "stepId": "invoke",
          "testName": "recipe proof repairs once per unresolved state and returns actual stopped progress",
          "implementationPaths": [
            "packages/ai-agent-runtime/src/recipe-execution.ts"
          ]
        },
        {
          "id": "register.iteration",
          "stepId": "register",
          "testName": "recipe proof refuses nested repair expansion before publishing the candidate",
          "implementationPaths": [
            "packages/ai-agent-runtime/src/tool-library.ts"
          ]
        },
        {
          "id": "persist.iteration",
          "stepId": "persist",
          "testName": "recipe proof saves and reloads the complete bounded iteration without replay",
          "implementationPaths": [
            "packages/ai-agent-runtime/src/tool-store.ts"
          ]
        },
        {
          "id": "persist.iteration-resume",
          "stepId": "persist",
          "testName": "resumes a bounded candidate privately without executing or losing its iteration",
          "implementationPaths": [
            "packages/ai-agent-runtime/src/tool-store.ts"
          ]
        },
        {
          "id": "persist.nested",
          "stepId": "persist",
          "testName": "recipe proof saves nested candidates dependency-first without replay",
          "implementationPaths": [
            "packages/ai-agent-runtime/src/tool-store.ts"
          ]
        },
        {
          "id": "persist.authority",
          "stepId": "persist",
          "testName": "recipe proof confirms durable authority after asynchronous preparation without replay",
          "implementationPaths": [
            "packages/ai-agent-runtime/src/tool-store.ts"
          ]
        }
      ],
      "handoffs": [
        {
          "routeId": "admit-to-register",
          "decision": "required",
          "caseIds": [
            "register.handoff"
          ]
        },
        {
          "routeId": "admit-to-persist",
          "decision": "required",
          "caseIds": [
            "persist.handoff"
          ]
        },
        {
          "routeId": "register-to-invoke",
          "decision": "required",
          "caseIds": [
            "invoke.handoff"
          ]
        },
        {
          "routeId": "register-to-persist",
          "decision": "required",
          "caseIds": [
            "persist.handoff"
          ]
        },
        {
          "routeId": "invoke-to-persist",
          "decision": "required",
          "caseIds": [
            "persist.handoff",
            "persist.nested",
            "persist.authority"
          ]
        },
        {
          "routeId": "persist-to-admit",
          "decision": "required",
          "caseIds": [
            "persist.handoff",
            "persist.iteration-resume",
            "persist.nested",
            "persist.authority"
          ]
        }
      ]
    }
  ],
  "defaultNegativeScenario": "allow-control-plane",
  "scenarios": [
    {
      "id": "baseline",
      "title": "Current composition owners",
      "expectedFailedCaseIds": []
    },
    {
      "id": "allow-control-plane",
      "title": "Allow a control-plane dependency",
      "expectedFailedCaseIds": [
        "admit.handoff"
      ],
      "mutation": {
        "file": "packages/ai-agent-runtime/src/recipe-admission.ts",
        "from": "contract.composition !== 'allowed'",
        "to": "false"
      }
    },
    {
      "id": "ignore-repair-budget",
      "title": "Ignore bounded repair round limit",
      "expectedFailedCaseIds": [
        "invoke.iteration",
        "persist.iteration"
      ],
      "mutation": {
        "file": "packages/ai-agent-runtime/src/recipe-execution.ts",
        "from": "if (round >= iteration.maxIterations)",
        "to": "if (false)"
      }
    },
    {
      "id": "copy-registration-receipt",
      "title": "Lose registration receipt identity",
      "expectedFailedCaseIds": [
        "register.handoff"
      ],
      "mutation": {
        "file": "packages/ai-agent-runtime/src/tool-library.ts",
        "from": "return previous.result",
        "to": "return { ...previous.result }"
      }
    },
    {
      "id": "omit-invocation-calls",
      "title": "Omit invocation call inventory",
      "expectedFailedCaseIds": [
        "invoke.handoff",
        "persist.handoff",
        "invoke.iteration",
        "persist.iteration",
        "persist.iteration-resume",
        "persist.nested",
        "persist.authority"
      ],
      "mutation": {
        "file": "packages/ai-agent-runtime/src/recipe-execution.ts",
        "from": "calls: Object.freeze(records.slice(start))",
        "to": "calls: Object.freeze([])"
      }
    },
    {
      "id": "omit-reload-name",
      "title": "Omit reloaded tool identity",
      "expectedFailedCaseIds": [
        "persist.handoff",
        "persist.iteration",
        "persist.nested"
      ],
      "mutation": {
        "file": "packages/ai-agent-runtime/src/tool-store.ts",
        "from": "loaded.push(record.contract.name)",
        "to": "loaded.push('')"
      }
    },
    {
      "id": "omit-nested-proof",
      "title": "Lose genuine child composition evidence",
      "expectedFailedCaseIds": [
        "persist.nested"
      ],
      "mutation": {
        "file": "packages/ai-agent-runtime/src/recipe-execution.ts",
        "from": "if (pinned.recipe) children.push(child)",
        "to": "if (false) children.push(child)"
      }
    },
    {
      "id": "ignore-final-store-authority",
      "title": "Ignore the final durable entry confirmation",
      "expectedFailedCaseIds": [
        "persist.authority"
      ],
      "mutation": {
        "file": "packages/ai-agent-runtime/src/tool-store.ts",
        "from": "!current ||\n    current.key !== entry.key ||\n    current.version !== entry.version ||\n    !same(current.record, entry.record)",
        "to": "false"
      }
    }
  ]
}
