{
  "version": 2,
  "manifestPath": "packages/ai-agent-runtime/flow-contracts.json",
  "targetId": "reusable-tool-composition",
  "architecturePath": "tools/flow-inspector/inspectors/reusable-tool-composition-flow-inspector.data.cjs",
  "specPath": "packages/ai-agent-runtime/TOOL_SPECIFICATION.md",
  "testFile": "packages/ai-agent-runtime/src/__tests__/recipe-flow.test.ts",
  "configFile": "packages/ai-agent-runtime/src/__tests__/recipe-flow.config.ts",
  "negativeCaseIds": [
    "admit.handoff",
    "register.handoff",
    "invoke.handoff",
    "persist.handoff"
  ],
  "externalInputs": [],
  "flows": [
    {
      "id": "reusable-tool-lifecycle",
      "title": "Reusable tool lifecycle",
      "goal": "Verify typed admission, same-registry request visibility, secured invocation and durable reuse.",
      "stepIds": ["admit", "register", "invoke", "persist"],
      "cases": [
        {
          "id": "admit.handoff",
          "stepId": "admit",
          "testName": "recipe proof rejects ineligible dependencies before registration",
          "implementationPaths": [
            "packages/ai-agent-runtime/src/recipe-admission.ts",
            "packages/ai-agent-runtime/src/recipe-schema.ts",
            "packages/ai-agent-runtime/src/tool-contract.ts"
          ]
        },
        {
          "id": "register.handoff",
          "stepId": "register",
          "testName": "recipe proof registers retry-safe scoped candidates in the canonical registry",
          "implementationPaths": [
            "packages/ai-agent-runtime/src/tool-library.ts",
            "packages/ai-agent-runtime/src/action-registry.ts"
          ]
        },
        {
          "id": "invoke.handoff",
          "stepId": "invoke",
          "testName": "recipe proof executes nested tools without scheduler deadlock or lost references",
          "implementationPaths": [
            "packages/ai-agent-runtime/src/recipe-execution.ts",
            "packages/ai-agent-runtime/src/invocation.ts",
            "packages/ai-agent-runtime/src/tool-contract.ts"
          ]
        },
        {
          "id": "persist.handoff",
          "stepId": "persist",
          "testName": "recipe proof saves without replay and validates durable reuse",
          "implementationPaths": [
            "packages/ai-agent-runtime/src/tool-store.ts",
            "packages/ai-agent-runtime/src/tool-library.ts",
            "packages/ai-agent-runtime/src/action-registry.ts"
          ]
        }
      ],
      "handoffs": [
        {
          "routeId": "admit-to-register",
          "decision": "required",
          "caseIds": ["register.handoff"]
        },
        {
          "routeId": "admit-to-persist",
          "decision": "required",
          "caseIds": ["persist.handoff"]
        },
        {
          "routeId": "register-to-invoke",
          "decision": "required",
          "caseIds": ["invoke.handoff"]
        },
        {
          "routeId": "register-to-persist",
          "decision": "required",
          "caseIds": ["persist.handoff"]
        },
        {
          "routeId": "invoke-to-persist",
          "decision": "required",
          "caseIds": ["persist.handoff"]
        },
        {
          "routeId": "persist-to-admit",
          "decision": "required",
          "caseIds": ["persist.handoff"]
        }
      ]
    }
  ],
  "defaultNegativeScenario": "allow-control-plane",
  "scenarios": [
    {
      "id": "baseline",
      "title": "Current composition owners",
      "expectedFailedCaseIds": []
    },
    {
      "id": "allow-control-plane",
      "title": "Allow a control-plane dependency",
      "expectedFailedCaseIds": ["admit.handoff"],
      "mutation": {
        "file": "packages/ai-agent-runtime/src/recipe-admission.ts",
        "from": "contract.composition !== 'allowed'",
        "to": "false"
      }
    },
    {
      "id": "copy-registration-receipt",
      "title": "Lose registration receipt identity",
      "expectedFailedCaseIds": ["register.handoff"],
      "mutation": {
        "file": "packages/ai-agent-runtime/src/tool-library.ts",
        "from": "return previous.result",
        "to": "return { ...previous.result }"
      }
    },
    {
      "id": "omit-invocation-calls",
      "title": "Omit invocation call inventory",
      "expectedFailedCaseIds": ["invoke.handoff"],
      "mutation": {
        "file": "packages/ai-agent-runtime/src/recipe-execution.ts",
        "from": "calls: Object.freeze(records.slice(start))",
        "to": "calls: Object.freeze([])"
      }
    },
    {
      "id": "omit-reload-name",
      "title": "Omit reloaded tool identity",
      "expectedFailedCaseIds": ["persist.handoff"],
      "mutation": {
        "file": "packages/ai-agent-runtime/src/tool-store.ts",
        "from": "loaded.push(record.contract.name)",
        "to": "loaded.push('')"
      }
    }
  ]
}
