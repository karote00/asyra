{
  "version": 1,
  "workspaceRoots": ["apps", "packages", "tools"],
  "excludedRoots": {
    "create-app": "archive-readiness"
  },
  "sharedInputPaths": [".yarnrc.yml", "tsconfig.json", "scripts/gen-turbo.js"],
  "sharedInputPatterns": [],
  "workspaceLocalInputPatterns": [
    "**/coverage-flow-contracts.json",
    "**/navigation-flow-contracts.json"
  ],
  "rootDocumentationPaths": [
    "README.md",
    "SUPPORT.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md",
    "RELEASE_NOTES.md",
    "AGENTS.md"
  ],
  "sharedValidationPatterns": [
    ".github/**",
    ".changeset/**",
    "docs/ai/framework/**",
    "docs/ai/workflows/**"
  ],
  "lintFullInputPaths": [
    "eslint.config.js",
    "eslint.config.mjs",
    ".gitignore",
    "tsconfig.json"
  ],
  "e2eSuites": [
    {
      "id": "collaboration",
      "specs": [
        "collaboration.spec.ts",
        "collaboration-ai-agent-video.spec.ts"
      ],
      "inputs": [
        "apps/asyra-design/e2e/collaboration.spec.ts",
        "apps/asyra-design/e2e/collaboration-ai-agent-video.spec.ts"
      ],
      "supportInputs": ["apps/asyra-design/e2e/**", "scripts/run-e2e.sh"],
      "localCommand": {
        "executable": "yarn",
        "args": [
          "workspace",
          "@asyra/asyra-design",
          "test:e2e:collaboration",
          "--reporter=line,json",
          "--workers=1",
          "--max-failures=1"
        ],
        "env": {},
        "evidence": "playwright"
      }
    },
    {
      "id": "render-contracts",
      "specs": ["render-delta-performance.spec.ts"],
      "inputs": ["apps/asyra-design/e2e/render-delta-performance.spec.ts"],
      "supportInputs": ["apps/asyra-design/e2e/**", "scripts/run-e2e.sh"],
      "localCommand": {
        "executable": "yarn",
        "args": [
          "workspace",
          "@asyra/asyra-design",
          "test:e2e",
          "e2e/render-delta-performance.spec.ts",
          "--reporter=line,json",
          "--workers=1",
          "--max-failures=1"
        ],
        "env": {},
        "evidence": "playwright"
      }
    },
    {
      "id": "functional",
      "specs": [],
      "inputs": [
        "apps/asyra-design/e2e/**.spec.ts",
        "apps/asyra-design/e2e/**.spec.tsx",
        "apps/asyra-design/e2e/**.test.ts"
      ],
      "supportInputs": ["apps/asyra-design/e2e/**", "scripts/run-e2e.sh"],
      "localCommand": {
        "executable": "yarn",
        "args": [
          "workspace",
          "@asyra/asyra-design",
          "test:e2e",
          "--reporter=line,json",
          "--workers=1",
          "--max-failures=1"
        ],
        "env": {
          "E2E_SKIP_PERFORMANCE": "true"
        },
        "evidence": "playwright"
      }
    },
    {
      "id": "flow-inspector-board",
      "specs": [],
      "inputs": [
        "tools/flow-inspector/control-plane/board*",
        "tools/flow-inspector/control-plane/__tests__/board*",
        "tools/flow-inspector/control-plane/server.cjs",
        "tools/flow-inspector/control-plane/service.cjs"
      ],
      "localCommand": {
        "executable": "node",
        "args": [
          "--test",
          "--test-concurrency=1",
          "--test-reporter=tap",
          "tools/flow-inspector/control-plane/__tests__/board*.test.cjs"
        ],
        "env": {
          "FLOW_PROOF_URL": "http://127.0.0.1:4318",
          "FLOW_PROOF_BROWSER_CHANNEL": "chrome"
        },
        "evidence": "tap"
      }
    }
  ],
  "workspaceInputRules": [
    {
      "pattern": "docs/public/**",
      "workspaceDirectory": "apps/asyra-framework-site"
    },
    {
      "pattern": ".github/workflows/fieldscope-profile.yml",
      "workspaceDirectory": "apps/fieldscope"
    }
  ],
  "frameworkReleaseReadinessPaths": [
    "scripts/framework-release-artifacts.js",
    "scripts/framework-release-packages.js",
    "scripts/release-package-artifacts.js",
    "scripts/release-packages.mjs",
    "scripts/release-readiness.js",
    "scripts/release-records.js",
    "scripts/release-template-readiness.js",
    "scripts/release-validate.js",
    "scripts/release-validation-environment.js",
    "scripts/release-validation-workspace.js"
  ],
  "flowInspectorValidationWorkspaceDirectory": "tools/flow-inspector",
  "repositoryScriptGroups": {
    "developerAgent": {
      "ownsInputs": true,
      "patterns": [
        ".agents/plugins/marketplace.json",
        ".claude-plugin/marketplace.json",
        "plugins/asyra-agent/**",
        "plugins/asyra-developer/**",
        "docs/ai/tools/developer-agent/*.md",
        "docs/ai/tools/developer-agent/baselines/*.bundle.json",
        "scripts/developer-agent-bundle.mjs"
      ],
      "tests": ["scripts/__tests__/developer-agent-bundle.test.mjs"],
      "requiresFrameworkDeclarations": false
    },
    "plans": {
      "patterns": [
        "docs/ai/**/plans/**",
        "docs/ai/**/PLANS.md",
        "docs/ai/**/decisions/**"
      ],
      "tests": [
        "scripts/__tests__/plan-closeout.test.mjs",
        "scripts/__tests__/task-context.test.mjs"
      ],
      "requiresFrameworkDeclarations": false
    },
    "workflows": {
      "patterns": [
        "docs/ai/workflows/**",
        "docs/ai/framework/rules/**",
        "AGENTS.md",
        "docs/ai/**/WORKFLOW.md"
      ],
      "tests": [
        "scripts/__tests__/plan-closeout.test.mjs",
        "scripts/__tests__/task-context.test.mjs",
        "scripts/__tests__/ci-scope.test.mjs",
        "scripts/__tests__/workspace-automation.test.mjs",
        "scripts/__tests__/changeset-pr-check.test.mjs"
      ],
      "requiresFrameworkDeclarations": false
    },
    "publicSourceMap": {
      "patterns": ["docs/public/generated/source-map.json"],
      "tests": ["scripts/docs/__tests__/public-source-map.test.mjs"],
      "requiresFrameworkDeclarations": false
    },
    "publicDocumentation": {
      "patterns": [
        "docs/public/**",
        "packages/**/README.md",
        "README.md",
        "SUPPORT.md",
        "SECURITY.md",
        "LICENSE",
        "create-app/**/README.md",
        "apps/asyra-design/README.md"
      ],
      "tests": [
        "scripts/docs/__tests__/public-content-contract.test.mjs",
        "scripts/docs/__tests__/public-documentation-inputs.test.mjs",
        "scripts/docs/__tests__/public-documentation-validation.test.mjs",
        "scripts/docs/__tests__/public-documentation.test.mjs",
        "scripts/docs/__tests__/public-package-readmes.test.mjs",
        "scripts/docs/__tests__/public-package-reference.test.mjs",
        "scripts/docs/__tests__/public-readme-inputs.test.mjs",
        "scripts/docs/__tests__/public-readme-validation.test.mjs",
        "scripts/docs/__tests__/support-policy-validation.test.mjs",
        "scripts/docs/__tests__/public-source-map.test.mjs"
      ],
      "requiresFrameworkDeclarations": true
    },
    "internalDocumentation": {
      "patterns": [
        "docs/ai/**",
        "apps/**/docs/**",
        "apps/**/README.md",
        "tools/**/README.md"
      ],
      "tests": [],
      "requiresFrameworkDeclarations": false
    },
    "publicSources": {
      "patterns": [],
      "tests": ["scripts/docs/__tests__/public-source-map.test.mjs"],
      "requiresFrameworkDeclarations": false
    },
    "ci": {
      "patterns": [
        "scripts/ci-*",
        "scripts/run-ci-checks.mjs",
        "scripts/run-workspace-checks.mjs",
        ".github/workflows/main.yml",
        ".github/workflows/e2e.yml",
        "tools/flow-inspector/control-plane/ci-script-selection.cjs",
        "tools/flow-inspector/control-plane/workflow-results.cjs",
        "tools/flow-inspector/control-plane/ci-script-selection.cjs",
        "tools/flow-inspector/control-plane/workflow-results.cjs",
        "tools/flow-inspector/control-plane/__tests__/workflow-results.test.cjs",
        "docs/ai/tools/flow-inspector/CORE_PROOF.md",
        "scripts/run-e2e.sh",
        "scripts/balanced-ai-correctness-scope.mjs",
        "scripts/local-validation*.mjs",
        "docs/ai/workflows/local-affected-validation.md",
        "scripts/test-impact.mjs",
        "scripts/test-impact-workspaces.mjs"
      ],
      "tests": [
        "scripts/__tests__/ci-scope.test.mjs",
        "scripts/__tests__/workspace-automation.test.mjs",
        "tools/flow-inspector/control-plane/__tests__/workflow-results.test.cjs",
        "tools/flow-inspector/__tests__/package.test.cjs",
        "scripts/__tests__/release-automation.test.mjs",
        "scripts/__tests__/local-validation.test.mjs",
        "scripts/__tests__/local-validation-runner.test.mjs",
        "scripts/__tests__/test-impact.test.mjs"
      ],
      "requiresFrameworkDeclarations": false
    },
    "workspaceAutomation": {
      "patterns": [
        "package.json",
        "apps/*/package.json",
        "packages/*/package.json",
        "tools/*/package.json",
        "create-app/**/package.json",
        "turbo*.json",
        "scripts/gen-turbo.js",
        "scripts/check-test-exists.js",
        ".github/**",
        "eslint.config.*",
        "apps/asyra-design/vite.config.ts",
        "apps/asyra-design/src/index.css",
        "apps/**/tsconfig*.json",
        "packages/**/tsconfig*.json",
        "apps/**/postcss.config.*",
        "packages/**/postcss.config.*"
      ],
      "tests": [
        "scripts/__tests__/workspace-automation.test.mjs",
        "scripts/__tests__/deps-validate.test.mjs"
      ],
      "requiresFrameworkDeclarations": false
    },
    "buildExecution": {
      "patterns": [
