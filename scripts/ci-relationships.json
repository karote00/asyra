      "tests": [
        "scripts/__tests__/app-release-plan.test.mjs",
        "scripts/__tests__/app-release-service.test.mjs",
        "scripts/__tests__/app-release-provider.test.mjs",
        "scripts/__tests__/app-release-entry.test.mjs",
        "scripts/__tests__/app-release-workflow.test.mjs",
        "scripts/__tests__/app-release-verification.test.mjs",
        "scripts/__tests__/app-release-verification.test.mjs",
        "scripts/__tests__/production-artifact-resource-evidence.test.mjs"
      ],
      "requiresFrameworkDeclarations": false
    },
    "changesets": {
      "patterns": [".changeset/**", "scripts/changeset-*"],
      "tests": [
        "scripts/__tests__/changeset-all-patch.test.mjs",
        "scripts/__tests__/changeset-pr-check.test.mjs"
      ],
      "requiresFrameworkDeclarations": false
    },
    "agentAutomation": {
      "patterns": [
        "agents/**",
        ".codex/**",
        ".antigravity/**",
        "scripts/agent-*",
        "scripts/agent-coordination/**",
        "scripts/agent-evals/**",
