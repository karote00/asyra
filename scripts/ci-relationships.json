  "supervisedTestOwners": {
    "apps/fieldscope": {
      "task": "test:affected",
      "profileCommand": [
        "python3",
        "apps/fieldscope/scripts/run-profile-groups.py"
      ]
    },
    "apps/asyra-sim": {
      "task": "test:ci",
      "argumentStyle": "positional"
    }
  },
  "isolatedBrowserProofs": {
    "apps/asyra-sim": {
      "inventoryRoots": ["e2e", "src", "samples"],
      "groups": [
        {
          "proofPatterns": [
            "src/analysis/__tests__/budget-baseline.browser.spec.ts",
            "src/analysis/__tests__/runner.browser.spec.ts",
            "src/analysis/methods/__tests__/representative-resource-candidate-1.browser.spec.ts",
