        "scripts/__tests__/framework-release-publisher.test.mjs",
        "scripts/__tests__/framework-release-artifacts.test.mjs"
      ],
      "requiresFrameworkDeclarations": false
    },
    "appRelease": {
      "patterns": [
        "scripts/app-release*",
        "scripts/production-artifact*",
        ".github/workflows/app-release*",
        ".github/workflows/production-artifacts.yml",
        ".github/app-production-environment.json",
        "release-configs/**"
