            "src/analysis/methods/__tests__/representative-resource-candidate-3.browser.spec.ts",
            "src/analysis/methods/__tests__/runtime.browser.spec.ts",
            "src/domain/__tests__/runtime.browser.spec.ts"
          ],
          "sourcePatterns": [
            "src/analysis/**",
            "src/domain/**",
            "src/constants/**",
            "src/extensions/**",
            "src/engine/glb/**",
            "samples/**",
            "src/analysis/methods/__tests__/representative-fixture.ts"
          ]
        },
        {
          "proofPatterns": ["src/engine/glb/__tests__/runtime.browser.spec.ts"],
          "sourcePatterns": [
            "src/engine/glb/**",
            "src/domain/**",
            "src/constants/**"
          ]
        },
        {
          "proofPatterns": ["src/storage/__tests__/runtime.browser.spec.ts"],
          "sourcePatterns": [
            "src/storage/**",
            "src/domain/**",
            "src/constants/**"
          ]
        }
      ]
    }
  }
