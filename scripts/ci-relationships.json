      "tests": [
        "scripts/__tests__/agent-safety-hook.test.mjs",
        "scripts/agent-evals/__tests__/engine.test.mjs",
        "scripts/agent-coordination/__tests__/guard-core.test.cjs",
        "scripts/__tests__/agent-hook-adapter.test.mjs",
        "scripts/__tests__/merge-agent-subpr.test.mjs"
      ],
      "requiresFrameworkDeclarations": false
    },
    "createApp": {
      "patterns": ["create-app/**", "scripts/create-app*"],
      "tests": ["scripts/__tests__/create-app-cli.test.mjs"],
      "requiresFrameworkDeclarations": false
    },
    "http": {
      "patterns": ["scripts/wait-for-http*"],
      "tests": ["scripts/__tests__/wait-for-http.test.mjs"],
      "requiresFrameworkDeclarations": false
    },
    "naming": {
      "patterns": [
        "scripts/brand-*",
        "scripts/display-name-*",
        "scripts/test-file-*"
      ],
      "tests": [
        "scripts/__tests__/test-file-placement.test.mjs",
        "scripts/__tests__/brand-neutral-code.test.mjs",
        "scripts/__tests__/display-name-separators.test.mjs"
      ],
      "requiresFrameworkDeclarations": false
    },
    "dependencies": {
      "patterns": [
        "scripts/deps-*",
        "package.json",
        "yarn.lock",
        ".yarn/patches/**"
      ],
      "tests": [
        "scripts/__tests__/deps-validate.test.mjs",
        "scripts/__tests__/dependency-consumers.test.mjs"
      ],
      "requiresFrameworkDeclarations": false
    },
    "planImplementation": {
      "patterns": [
        "scripts/task-context.mjs",
        "scripts/plan-closeout.mjs",
        ".github/workflows/plan-workflow-tests.yml"
      ],
      "tests": [
        "scripts/__tests__/plan-closeout.test.mjs",
        "scripts/__tests__/task-context.test.mjs"
      ],
      "requiresFrameworkDeclarations": false
    },
    "appE2EGroups": {
      "patterns": [
