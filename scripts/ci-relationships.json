{
  "version": 1,
  "workspaceRoots": ["apps", "packages", "tools"],
  "excludedRoots": {
    "create-app": "archive-readiness"
  },
  "sharedInputPaths": [
    "package.json",
    "yarn.lock",
    ".yarnrc.yml",
    "turbo.base.json",
    "turbo.json",
    ".gitignore",
    "eslint.config.js",
    "eslint.config.mjs",
    "tsconfig.json",
    "scripts/gen-turbo.js",
    "scripts/ci-scope.mjs",
    "scripts/ci-relationships.json",
    "scripts/run-ci-checks.mjs",
    "scripts/run-workspace-checks.mjs",
    "tools/flow-inspector/control-plane/ci-script-selection.cjs"
  ],
  "sharedInputPatterns": [".github/workflows/**"],
  "rootDocumentationPaths": [
    "README.md",
    "SUPPORT.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md",
    "RELEASE_NOTES.md",
    "AGENTS.md"
  ],
  "sharedValidationPatterns": [
    ".github/**",
    ".changeset/**",
    "docs/ai/framework/**",
    "docs/ai/workflows/**"
  ],
  "lintFullInputPaths": [
    "eslint.config.js",
    ".gitignore",
    "package.json",
    "yarn.lock",
    ".yarnrc.yml",
    "tsconfig.json",
    "eslint.config.mjs"
  ],
  "repositoryScriptsInputPatterns": [
    "scripts/**",
    ".github/**",
    ".changeset/**",
    "apps/**",
    "packages/**",
    "tools/**",
    "create-app/**",
    "agents/**",
    "release-configs/**",
    ".codex/**",
    ".antigravity/**",
    "package.json",
    "AGENTS.md",
    ".gitignore",
    ".env.example",
    "README.md",
    "SUPPORT.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md",
    "RELEASE_NOTES.md",
    "vercel.json",
    "turbo.json",
    "turbo.base.json",
    "tsconfig.json",
    "eslint.config.js",
    "eslint.config.mjs",
    "yarn.lock",
    ".yarnrc.yml",
    ".yarn/patches/**"
  ],
  "e2eSuites": [
    {
      "id": "collaboration",
      "specs": [
        "collaboration.spec.ts",
        "collaboration-ai-agent-video.spec.ts"
      ],
      "inputs": [
        "apps/asyra-design/e2e/collaboration.spec.ts",
        "apps/asyra-design/e2e/collaboration-ai-agent-video.spec.ts"
      ],
      "supportInputs": ["apps/asyra-design/e2e/**", "scripts/run-e2e.sh"]
    },
    {
      "id": "render-contracts",
      "specs": ["render-delta-performance.spec.ts"],
      "inputs": ["apps/asyra-design/e2e/render-delta-performance.spec.ts"],
      "supportInputs": ["apps/asyra-design/e2e/**", "scripts/run-e2e.sh"]
    },
    {
      "id": "functional",
      "specs": [],
      "inputs": [
        "apps/asyra-design/e2e/**.spec.ts",
        "apps/asyra-design/e2e/**.spec.tsx",
        "apps/asyra-design/e2e/**.test.ts"
      ],
      "supportInputs": ["apps/asyra-design/e2e/**", "scripts/run-e2e.sh"]
    },
    {
      "id": "flow-inspector-board",
      "specs": [],
      "inputs": ["tools/flow-inspector/**"]
    }
  ],
  "workspaceInputRules": [
    {
      "pattern": "scripts/**",
      "workspaceDirectory": "tools/flow-inspector"
    },
    {
      "pattern": ".changeset/**",
      "workspaceDirectory": "tools/flow-inspector"
    },
    {
      "pattern": "docs/public/**",
      "workspaceDirectory": "apps/asyra-framework-site"
    },
    {
      "pattern": "docs/ai/apps/{slug}/**",
      "workspaceDirectory": "apps/{slug}"
    },
    {
      "pattern": "docs/ai/packages/{slug}/**",
      "workspaceDirectory": "packages/{slug}"
    },
    {
      "pattern": "docs/ai/tools/{slug}/**",
      "workspaceDirectory": "tools/{slug}"
    }
  ],
  "frameworkReleaseReadinessPaths": [
    "scripts/framework-release-artifacts.js",
    "scripts/framework-release-packages.js",
    "scripts/release-package-artifacts.js",
    "scripts/release-packages.mjs",
    "scripts/release-readiness.js",
    "scripts/release-records.js",
    "scripts/release-template-readiness.js",
    "scripts/release-validate.js",
    "scripts/release-validation-environment.js",
    "scripts/release-validation-workspace.js"
  ],
  "flowInspectorValidationWorkspaceDirectory": "tools/flow-inspector",
  "repositoryScriptGroups": {
    "plans": {
      "patterns": [
        "docs/ai/**/plans/**",
        "docs/ai/**/PLANS.md",
        "docs/ai/**/decisions/**"
      ],
      "tests": [
        "scripts/__tests__/plan-closeout.test.mjs",
        "scripts/__tests__/task-context.test.mjs"
      ],
      "requiresFrameworkDeclarations": false
    },
    "workflows": {
      "patterns": [
        "docs/ai/workflows/**",
        "docs/ai/framework/rules/**",
        "AGENTS.md",
        "docs/ai/**/WORKFLOW.md"
      ],
      "tests": [
        "scripts/__tests__/plan-closeout.test.mjs",
        "scripts/__tests__/task-context.test.mjs",
        "scripts/__tests__/ci-scope.test.mjs",
        "scripts/__tests__/workspace-automation.test.mjs",
        "scripts/__tests__/changeset-pr-check.test.mjs"
      ],
      "requiresFrameworkDeclarations": false
    },
    "publicSourceMap": {
      "patterns": ["docs/public/generated/source-map.json"],
      "tests": ["scripts/docs/__tests__/public-source-map.test.mjs"],
      "requiresFrameworkDeclarations": false
    },
    "publicDocumentation": {
      "patterns": [
        "docs/public/**",
        "packages/**/README.md",
        "README.md",
        "SUPPORT.md",
        "SECURITY.md",
        "LICENSE",
        "create-app/**/README.md",
        "apps/asyra-design/README.md"
      ],
      "tests": [
        "scripts/docs/__tests__/public-content-contract.test.mjs",
        "scripts/docs/__tests__/public-documentation-inputs.test.mjs",
        "scripts/docs/__tests__/public-documentation-validation.test.mjs",
        "scripts/docs/__tests__/public-documentation.test.mjs",
        "scripts/docs/__tests__/public-package-readmes.test.mjs",
        "scripts/docs/__tests__/public-package-reference.test.mjs",
        "scripts/docs/__tests__/public-readme-inputs.test.mjs",
        "scripts/docs/__tests__/public-readme-validation.test.mjs",
        "scripts/docs/__tests__/support-policy-validation.test.mjs",
        "scripts/docs/__tests__/public-source-map.test.mjs"
      ],
      "requiresFrameworkDeclarations": true
    },
    "internalDocumentation": {
      "patterns": [
        "docs/ai/**",
        "apps/**/docs/**",
        "apps/**/README.md",
        "tools/**/README.md"
      ],
      "tests": ["scripts/__tests__/workspace-automation.test.mjs"],
      "requiresFrameworkDeclarations": false
    },
    "publicSources": {
      "patterns": [],
      "tests": ["scripts/docs/__tests__/public-source-map.test.mjs"],
      "requiresFrameworkDeclarations": false
    }
  }
}
