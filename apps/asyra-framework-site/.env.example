# Set the public HTTPS origin for the deployment being built, then rebuild.
NEXT_PUBLIC_SITE_URL=https://asyra-framework.vercel.app
NEXT_PUBLIC_SITE_INDEXING=true
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# Vercel supplies VERCEL_ENV automatically and it takes precedence.
# For an independently hosted static production build, set SITE_ENV=production.
# Leave blank for local development; use preview for non-production exports.
SITE_ENV=
