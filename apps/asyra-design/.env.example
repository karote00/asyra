APP_URL=http://localhost:3000
DOCUMENT_BACKEND_HOST=127.0.0.1
DOCUMENT_BACKEND_PORT=4201
COLLABORATION_WS_HOST=127.0.0.1
COLLABORATION_WS_PORT=4101
DOCUMENT_PERSISTENCE_BACKEND_URL=http://127.0.0.1:4201
VITE_COLLABORATION_WS_URL=ws://127.0.0.1:4101/collaboration

# Local AI uses your own Codex subscription. Install Codex and sign in first.
AI_PROVIDER_BACKEND=local-codex
AI_PROVIDER_MODEL=gpt-6-astra
# Use codex on PATH, or set an absolute path in your local .env.
# macOS Codex App example: /Applications/ChatGPT.app/Contents/Resources/codex
AI_PROVIDER_EXECUTABLE=codex

# Local diagnostic records; relative to the App server working directory.
AI_EXECUTION_RECORD_DIR=tmp/ai-executions
# Optional exact tested source revision; leave empty when unavailable.
AI_EXECUTION_SOURCE_REVISION=

# Run the retained visual-assessment case pair (uses local AI subscription).
VISUAL_ASSESSMENT_LIVE=false
# Optional exact saved case ID; empty runs both cases.
VISUAL_ASSESSMENT_CASE=

# Optional recorded-action manifest for deterministic inspection/durability replay.
E2E_INSPECTION_REPLAY=
