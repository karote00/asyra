      {
        "name": "design_operations.record_design_facts",
        "arguments": {
          "facts": [
            {
              "id": "height",
              "statement": "建築師與CTBUH記載台北101總高508公尺、地上101層。",
              "scope": "整棟建築高度；不代表所有局部尺寸均有實測來源。",
              "sources": [
                "https://www.onenessarchitects.com/project/Taipei-101",
                "https://www.skyscrapercenter.com/building/taipei-101/117"
              ],
              "verification": "兩項公開資料一致。",
              "dependencies": [
                {
                  "key": "published-height",
                  "version": "2026-11-08"
                }
              ]
            },
            {
              "id": "modules",
              "statement": "26層以上八組八層外擴模組；ENR報導外傾約7度、下部內傾約5度。",
              "scope": "立面主結構；文獻底寬53m與另一文獻63.5m不一致，因此本圖底寬採63.5m估測，非測繪。",
              "sources": [
                "https://www.enr.com/articles/37144-megastructure-supports-taipei-s-508-meter-megatower",
                "https://ndl.ethernet.edu.et/bitstream/123456789/46132/1/Tall%20Buildings%20Structural%20Systems%20and%20Aerodynamic%20Form.pdf"
              ],
              "verification": "保留來源差異；模組樓高採約4.2m，8層33.6m。",
              "dependencies": [
                {
                  "key": "published-form",
                  "version": "2026-11-08"
                }
              ]
            }
          ]
        }
      },
