  "setup": {
    "operations": [
      {
        "id": "plan",
        "name": "design_operations.define_design_criteria",
        "arguments": {
          "method": "以公尺世界座標、100 px/m、方位35度俯角25度固定正投影建立可編輯2D向量。原圖用於造型與細節，不複製其透視。高度採508m，模組與局部寬度依文獻與照片估測，非施工圖。背景透明。",
          "references": [
            "https://www.onenessarchitects.com/project/Taipei-101",
            "https://www.skyscrapercenter.com/building/taipei-101/117",
            "https://www.enr.com/articles/37144-megastructure-supports-taipei-s-508-meter-megatower",
            "https://skyscraper.org/tallest-towers/taipei-101/"
          ],
          "criteria": {
            "whole": {
              "requirement": "Entire Taipei 101, base to spire, highly detailed realistic architectural illustration.",
              "description": "完整輪廓、八節外擴竹節、塔冠尖頂與基座，不加背景或圖說。",
              "verification": "visual",
              "requiredUnits": []
            },
            "view": {
              "requirement": "Fixed elevated three-quarter view with visible top surfaces and consistent perspective.",
              "description": "兩個可見立面及退縮屋頂使用同一固定投影，呈現俯視。",
              "verification": "visual",
              "requiredUnits": []
            },
            "detail": {
              "requirement": "Façade structure, window frames, visible ornamentation, realistic materials lighting and shadows; not schematic.",
              "description": "檢視入口與基座、竹節層的窗框及如意龍紋、塔冠設備及尖頂；玻璃反射、金屬亮邊與遮蔭具深度。",
              "verification": "visual",
              "requiredUnits": ["base", "tiers", "crown"]
            },
            "scale": {
              "requirement": "Real-world dimensions at 1 cm = 1 px before projection; projected lengths reflect viewing angle.",
              "description": "世界公尺座標×100，以同一投影轉成向量；總高508m。局部缺少尺寸的構件記為估測。",
              "verification": "data"
            },
            "editable": {
              "requirement": "Use editable 2D shapes.",
              "description": "窗格、窗框、飾件及表面皆為原生可編輯向量或橢圓，不插入點陣圖。",
              "verification": "data"
            }
          },
          "detailRequired": true
        }
      },
      {
        "name": "design_operations.select_design_references",
        "arguments": {
          "referenceImageIndexes": [1, 0],
          "requirementRevision": {
            "kind": "step",
