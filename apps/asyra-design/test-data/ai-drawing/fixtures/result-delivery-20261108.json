        "id": "facts",
        "name": "design_operations.record_design_facts",
        "arguments": {
          "facts": [
            {
              "id": "height",
              "statement": "Architect's project page gives height 508 m and floors B5–101F.",
              "scope": "Whole architectural height, not individual component sizes.",
              "sources": [
                "https://www.onenessarchitects.com/project/Taipei-101"
              ],
              "verification": "Read height and floor fields on architect's page.",
              "dependencies": [
                {
                  "key": "architect-project",
                  "version": "2026-11-08"
                }
              ]
            },
            {
              "id": "tiers",
              "statement": "Eight eight-storey flared modules above level 26; architect describes bamboo tiering, ruyi and dragon motifs and circular-square emblems at floors 24–27.",
              "scope": "Tier count and ornament identity; detailed ornament profiles and panel dimensions are visual estimates.",
              "sources": [
                "https://siny.org/wp-content/uploads/2014/12/2014_TallandSupertallBuildings_Preview.pdf",
                "https://www.onenessarchitects.com/project/Taipei-101"
              ],
              "verification": "Architect description and engineering chapter excerpt agree on stacked 8-storey form.",
              "dependencies": [
                {
                  "key": "architect-project",
                  "version": "2026-11-08"
                },
                {
                  "key": "engineering-chapter",
                  "version": "2014"
                }
              ]
            },
            {
              "id": "width",
              "statement": "Published structural reference gives ground cross-section 63.5 × 63.5 m; other engineering summary gives 45.9 m typical footprint, not adopted as ground width.",
              "scope": "Adopt 63.5 m tower base; 45.9 m used as typical narrow upper-tier width estimate. Does not verify podium dimensions.",
              "sources": [
                "https://ndl.ethernet.edu.et/bitstream/123456789/46132/1/Tall%20Buildings%20Structural%20Systems%20and%20Aerodynamic%20Form.pdf",
                "https://www.structuremag.org/article/dynamic-loading-solutions-in-taipei-101/"
              ],
              "verification": "Different source footprint scopes retained explicitly; base 6350 cm, tier neck approximately 4590 cm.",
              "dependencies": [
                {
                  "key": "structural-form",
                  "version": "2013"
                },
                {
                  "key": "structure-summary",
                  "version": "2026-11-08"
                }
              ]
            }
          ]
        }
      },
      {
        "name": "design_operations.record_design_calculations",
        "arguments": {
          "calculations": [
            {
              "id": "height-cm",
              "value": 50800,
              "unit": "cm = unprojected px",
              "sourceFactIds": [
                "height"
              ],
              "verification": "508 m × 100 cm/m; projection scale 1 px/cm. Preserve full source height, no fit scaling."
            },
            {
              "id": "base-cm",
              "value": 6350,
              "unit": "cm = unprojected px",
              "sourceFactIds": [
                "width"
              ],
              "verification": "63.5 × 100; use ±3175 cm around tower axis."
            }
          ]
        }
      }
    ],
    "response": "full",
    "retain": {
      "sources": {
        "step": "facts",
        "path": "/facts"
      }
    },
    "message": "保留建築參考、已知尺寸與估算範圍"
  },
  "select": {
    "operations": [
      {
        "id": "criteria",
        "name": "design_operations.define_design_criteria",
        "arguments": {
          "method": "Editable native projected planar faces, surface grids, gradients and explicit ornaments. All world coordinates in cm; orthographic elevated architectural three-quarter projection azimuth 35°, elevation 25°, scale 1 px/cm. Overall 508 m height is sourced; intermediate heights, facade spacing and podium dimensions are photo-based estimates, not survey data.",
          "references": [
            "https://www.onenessarchitects.com/project/Taipei-101",
            "https://www.taipei-tickets.com/taipei-101-observatory/"
          ],
          "criteria": {
            "whole": {
              "requirement": "Entire Taipei 101 from base through spire, highly detailed realistic architectural illustration, not schematic.",
              "description": "Whole-building silhouette, all eight projecting bamboo tiers, tapered base and complete crown/spire; no added scenery or labels.",
              "verification": "visual",
              "requiredUnits": []
            },
            "view": {
              "requirement": "Fixed elevated three-quarter view, clear top surfaces and consistent perspective.",
              "description": "Visible two facades and terraces/roofs share one projection throughout.",
              "verification": "visual",
              "requiredUnits": []
            },
            "detail": {
              "requirement": "Preserve facade structure, window frames and visible ornamentation with realistic materials, light and shadows.",
              "description": "Native window grids, mullions, spandrels, tier rims and recess shadows, corner ornaments, circular emblems, podium and spire detailing at close range.",
              "verification": "visual",
              "requiredUnits": [
                "base",
                "tiers",
                "crown"
              ]
            },
            "scale": {
              "requirement": "Real-world dimensions at 1 cm = 1 px before projection; projected lengths reflect angle.",
              "description": "World z 0–50800 cm with scale 1, azimuth 35 elevation25; native output retains projected size. Source limitations documented.",
              "verification": "data"
            },
            "editable": {
              "requirement": "Use editable 2D shapes.",
              "description": "All building components native vectors/ovals and independent editable fills, no raster.",
              "verification": "data"
            }
          },
          "detailRequired": true
        }
      },
      {
        "id": "selectrefs",
