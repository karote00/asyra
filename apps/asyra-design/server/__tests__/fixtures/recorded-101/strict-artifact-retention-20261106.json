        "arguments": {
          "facts": [
            {
              "id": "height",
              "statement": "The architect and facade contractor both publish Taipei 101 height 508 m and 101 above-ground floors.",
              "scope": "Overall architectural height only; not exact local facade dimensions.",
              "sources": [
                "https://www.onenessarchitects.com/project/Taipei-101",
                "https://www.permasteelisagroup.com/historic-project/taipei-101/"
              ],
              "verification": "Read architect project height 508m and contractor key facts.",
              "dependencies": [
                {
                  "key": "architect-project",
                  "version": "2026-11-06"
                }
              ]
            },
            {
              "id": "tiers-material",
              "statement": "Eight eight-storey outward-flaring modules above a tapering base; blue-green curtain wall with aluminium, stainless steel and stone. Ruyi, dragon corner ornaments and circular transition emblems are documented.",
              "scope": "Visible architectural arrangement and materials; local sizes and module elevations in this illustration are proportional estimates.",
              "sources": [
                "https://global.ctbuh.org/resources/papers/1650-Poon_2004_StructuralDesignTaipei.pdf",
                "https://www.onenessarchitects.com/project/Taipei-101",
                "https://www.permasteelisagroup.com/historic-project/taipei-101/"
              ],
              "verification": "Architect describes eight floors per segment and symbolism; CTBUH search excerpt describes eight modules; contractor lists materials. Photo observations guide appearance, not surveyed dimensions.",
              "dependencies": [
                {
                  "key": "architect-project",
                  "version": "2026-11-06"
                }
              ]
            }
          ]
        }
