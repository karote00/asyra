{
  "type": "group",
  "name": "Taipei Dome · plaza-side aerial portrait",
  "brief": {
    "intent": "An isolated, editable exterior study of the arena, including its visible plinth, glazed concourse, tiered titanium skin and offset crown.",
    "viewpoint": "Fixed elevated oblique view after Archasia R-12. All geometry and cell boundaries use the same photographic projection. The XY grid is the already projected picture plane.",
    "sources": [
      "Archasia 1.3.2R-12.webp: main silhouette, warm left-hand reflection, entrance ribbons, glazing and cladding.",
      "Archasia 1.3.2T-02.webp: stepped offset crown, roof-field divisions and front signage.",
      "Populous: approximately 270 × 170 m plan; Taipei City tourism: 74.5 m ground to roof."
    ],
    "assumptions": [
      "100 pixels/metre before foreshortening. Approximate 33-degree plan rotation gives a 245 m projected span; 38 drawing pixels per reference-preview pixel. Secondary member sizes inferred from photographs, not survey data."
    ]
  },
