    "segmentCountMeaning": "starting-samples",
    "meshSampling": {
      "maxRefinementPasses": 12,
      "angularRule": "Start with bodyRadial; add four until rMax*(1-cos(pi/N)) <= angularChordTolerance. Use one angular index grid across each connected loft.",
      "heightRule": "Start with loftIntervals per source interval. Retain source rows; bisect failing intervals. The female default has no groove rings.",
      "triangles": "Each cell uses (v00,v10,v11) and (v00,v11,v01); reverse winding if needed for outward normals. Shared vertices, periodic angular wrap, no duplicate seam vertices.",
      "refinementProbes": [0.25, 0.5, 0.75],
      "validationProbes": [0.125, 0.375, 0.625, 0.875],
      "errorMetric": "For each analytic cell probe, distance to the nearer of its two mesh triangles. Check all angular cells. Refinement probes use refinementThreshold; independent validation probes use surfaceTolerance. If radial error prevents convergence, add four angular samples and repeat.",
      "failurePolicy": "At the pass limit, failed independent validation, or exhausted triangle budget, reject delivery. Do not relax tolerances or silently omit required LOD0/LOD1 detail. Probe checks are sampled evidence; a final mesh still needs topology, fit and visual validation.",
      "precisionSource": "Use the selected lod.tiers entry sampling values. LOD0 preserves the 0.5 mm construction surface target; lower LOD approximation never relaxes attachment, wall separation or topology checks."
    }
